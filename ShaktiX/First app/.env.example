# ShaktiX Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3001

# Email Configuration (for notifications)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Alternative SMS Provider (Fonoster)
SMS_PROVIDER=twilio
FONOSTER_API_URL=https://your-fonoster-host/sms
FONOSTER_API_KEY=your-fonoster-api-key
FONOSTER_FROM=your-fonoster-sender-id

# Medical API Configuration (Infermedica)
INFERMEDICA_API_KEY=your-infermedica-api-key
INFERMEDICA_APP_ID=your-infermedica-app-id

# Deepfake Detection Configuration (Hugging Face)


